    TOP = "top"
    RIGHT = "right"
    BOTTOM = "bottom"
    LEFT = "left"


class PosterSceneFixturePlacement(StrEnum):
    """Describe whether a rendered fixture lives on the floor or wall margin."""

    FLOOR = "floor"
    WALL = "wall"


class PosterSceneLabelOrientation(StrEnum):
