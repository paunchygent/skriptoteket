        result = await self._session.execute(
            select(RoomTemplateModel)
            .where(RoomTemplateModel.owner_user_id == owner_user_id)
            .order_by(RoomTemplateModel.name)
        )
        return [
            RoomTemplate(
                id=model.id,
                owner_user_id=model.owner_user_id,
