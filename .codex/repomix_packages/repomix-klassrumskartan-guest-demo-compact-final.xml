    """Response payload for a curated app detail lookup."""

    model_config = ConfigDict(frozen=True)
    app_id: str
    tool_id: UUID
    title: str
    summary: str | None
    min_role: Role
    ui_mode: CuratedAppUiMode


@router.get("/{app_id}", response_model=AppDetailResponse)
async def get_app_by_id(
