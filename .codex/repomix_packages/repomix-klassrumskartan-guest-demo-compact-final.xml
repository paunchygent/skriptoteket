function buildCreateSeatingExportJobRequest(
  option: SeatingExportOption,
): CreateSeatingExportJobRequest {
  if (option === "xlsx") {
    return {
      export_kind: XLSX_EXPORT_KIND,
      layout_id: null,
      paper_size: null,
    };
  }
  return {
    export_kind: PDF_EXPORT_KIND,
    layout_id: LAYOUT_ID,
    paper_size: option,
  };
