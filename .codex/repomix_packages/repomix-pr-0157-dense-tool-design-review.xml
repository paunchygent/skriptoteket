  --huleedu-navy: #1C2E4A;          /* Primary dark blue */
  --huleedu-burgundy: #4D1521;      /* Accent/CTA color - darkened */

  /* Color with opacity variants (pre-computed for compatibility) */
  --huleedu-navy-02: rgba(28, 46, 74, 0.02);
  --huleedu-navy-05: rgba(28, 46, 74, 0.05);
  --huleedu-navy-10: rgba(28, 46, 74, 0.1);
  --huleedu-navy-20: rgba(28, 46, 74, 0.2);
  --huleedu-navy-30: rgba(28, 46, 74, 0.3);
  --huleedu-navy-40: rgba(28, 46, 74, 0.4);
  --huleedu-navy-50: rgba(28, 46, 74, 0.5);
  --huleedu-navy-60: rgba(28, 46, 74, 0.6);
  --huleedu-navy-70: rgba(28, 46, 74, 0.7);
  --huleedu-navy-80: rgba(28, 46, 74, 0.8);

  --huleedu-burgundy-05: rgba(77, 21, 33, 0.05);
  --huleedu-burgundy-10: rgba(77, 21, 33, 0.1);
  --huleedu-burgundy-20: rgba(77, 21, 33, 0.2);
  --huleedu-burgundy-30: rgba(77, 21, 33, 0.3);
  --huleedu-burgundy-40: rgba(77, 21, 33, 0.4);

  --huleedu-canvas-15: rgba(250, 250, 246, 0.15);
  --huleedu-canvas-30: rgba(250, 250, 246, 0.3);
  --huleedu-canvas-50: rgba(250, 250, 246, 0.5);
  --huleedu-canvas-80: rgba(250, 250, 246, 0.8);

  /* Semantic colors */
  --huleedu-success: #059669;       /* emerald-600 */
  --huleedu-warning: #D97706;       /* amber-600 */
  --huleedu-error: #DC2626;         /* red-600 */

  /* ─────────────────────────────────────────────────────────────────────────
     TYPOGRAPHY
     ───────────────────────────────────────────────────────────────────────── */
  --huleedu-font-sans: "IBM Plex Sans", system-ui, -apple-system, sans-serif;
  --huleedu-font-serif: "IBM Plex Serif", Georgia, "Times New Roman", serif;
  --huleedu-font-mono: "IBM Plex Mono", ui-monospace, "Courier New", monospace;

  /* Font sizes */
  --huleedu-text-xs: 0.75rem;       /* 12px - labels, meta */
  --huleedu-text-sm: 0.875rem;      /* 14px - body small, buttons */
  --huleedu-text-base: 1rem;        /* 16px - body default */
  --huleedu-text-lg: 1.125rem;      /* 18px - body large */
  --huleedu-text-xl: 1.25rem;       /* 20px - section titles */
  --huleedu-text-2xl: 1.5rem;       /* 24px - headings */
  --huleedu-text-3xl: 1.875rem;     /* 30px - headings */
  --huleedu-text-4xl: 2.25rem;      /* 36px - hero mobile */
  --huleedu-text-5xl: 3rem;         /* 48px - hero tablet */
