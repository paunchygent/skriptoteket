  --huleedu-space-20: 5rem;         /* 80px */

  /* ─────────────────────────────────────────────────────────────────────────
     BORDERS & RADIUS
     ───────────────────────────────────────────────────────────────────────── */
  --huleedu-border-width: 1px;
  --huleedu-border-width-2: 2px;
  --huleedu-border-color: var(--huleedu-navy);
  --huleedu-border-color-subtle: var(--huleedu-navy-30);

  --huleedu-radius-none: 0;
