/**
 * HuleEdu Design Tokens
 * =====================
 * Standalone CSS custom properties for harmonizing external projects
 * with the HuleEdu design system.
 *
 * Usage:
 *   1. Import this file: @import url('huleedu-design-tokens.css');
 *   2. Or link directly: <link rel="stylesheet" href="huleedu-design-tokens.css">
 *   3. Add Google Fonts in your HTML head:
 *      <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700;800&family=IBM+Plex+Serif:wght@400;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
 */

/* ═══════════════════════════════════════════════════════════════════════════
