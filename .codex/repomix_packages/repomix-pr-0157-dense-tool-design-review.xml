  --huleedu-radius-md: 4px;
  --huleedu-radius-lg: 8px;
  --huleedu-radius-xl: 12px;
  --huleedu-radius-full: 9999px;    /* Pills, dots */

  /* ─────────────────────────────────────────────────────────────────────────
     SHADOWS (Brutalist style)
     ───────────────────────────────────────────────────────────────────────── */
  --huleedu-shadow-brutal: 6px 6px 0px 0px var(--huleedu-navy);
  --huleedu-shadow-brutal-sm: 4px 4px 0px 0px var(--huleedu-navy);
