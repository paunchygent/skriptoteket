  opacity: 0;
  transform: translateY(12px);
}

@media (min-width: 768px) {
  .toast-enter-from,
  .toast-leave-to {
    transform: translateX(12px);
  }
}

.toast-move {
  transition: transform var(--huleedu-duration-slow) var(--huleedu-ease-default);
}

@media (prefers-reduced-motion: reduce) {
