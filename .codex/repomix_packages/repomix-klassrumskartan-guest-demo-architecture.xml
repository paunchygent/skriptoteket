      {
        openClassWorkspace: vi.fn(),
        openInitialHomeWorkspace: vi.fn(),
        syncWorkspaceTemplateSelection: vi.fn(),
        replaceActivePlannerRoster: vi.fn(),
        replaceActivePlannerTemplate,
