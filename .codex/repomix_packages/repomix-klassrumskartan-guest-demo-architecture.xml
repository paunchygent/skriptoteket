    assert update_kwargs["context"] == USAGE_INSTRUCTIONS_SESSION_CONTEXT
    assert update_kwargs["expected_state_rev"] == 0
    assert update_kwargs["state"][USAGE_INSTRUCTIONS_SEEN_HASH_KEY] == usage_hash


