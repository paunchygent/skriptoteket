const LAUNCHER_CHAIN_GUIDE_RAILS_3D = Object.freeze([
  {
    tag: "launcher/wall263-shoulder",
    donorSourceId: PROTOTYPE_ALPHA_VPW_DONOR_SOURCES.outerBoundary,
    path: VPW_OUTER_BOUNDARY_SHOOTER_CORRIDOR_PATH,
