  {
    tag: "launcher/wall019",
    donorSourceId: PROTOTYPE_ALPHA_VPW_DONOR_SOURCES.rightReceiveMouthInner,
    points: VPW_RIGHT_RECEIVE_MOUTH_INNER_POLYGON,
    heightBottom: scaleDonorLength(180),
    heightTop: scaleDonorLength(270),
