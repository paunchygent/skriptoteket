          </div>
        </Transition>
      </div>
    </div>

    <header class="space-y-2">
      <h1 class="page-title">{{ app?.title ?? (isLoading ? "Laddar..." : "Reagensberedning") }}</h1>
      <p
        v-if="app?.summary"
        class="page-description"
      >
        {{ app.summary }}
      </p>
    </header>

    <div
      v-if="isLoading"
