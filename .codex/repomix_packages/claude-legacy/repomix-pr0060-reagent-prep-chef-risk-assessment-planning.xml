class SequencedIdGenerator(IdGeneratorProtocol):
    def __init__(self, values: list[UUID]) -> None:
        self._values = values
        self._index = 0

    def new_uuid(self) -> UUID:
        if self._index >= len(self._values):
            raise RuntimeError("SequencedIdGenerator exhausted")
        value = self._values[self._index]
        self._index += 1
        return value


class InMemoryToolRunRepository(ToolRunRepositoryProtocol):
    def __init__(self) -> None:
        self.runs_by_id: dict[UUID, ToolRun] = {}

    async def get_by_id(self, *, run_id: UUID) -> ToolRun | None:
        return self.runs_by_id.get(run_id)

    async def create(self, *, run: ToolRun) -> ToolRun:
        self.runs_by_id[run.id] = run
        return run

    async def update(self, *, run: ToolRun) -> ToolRun:
        self.runs_by_id[run.id] = run
        return run

    async def get_latest_for_user_and_tool(
        self,
        *,
        user_id: UUID,
        tool_id: UUID,
        context: RunContext,
    ) -> ToolRun | None:
        candidates = [
            run
            for run in self.runs_by_id.values()
            if run.requested_by_user_id == user_id
            and run.tool_id == tool_id
            and run.context == context
        ]
        if not candidates:
            return None
        return max(candidates, key=lambda run: run.requested_at)

    async def list_for_user(
        self,
        *,
        user_id: UUID,
        context: RunContext,
        limit: int = 50,
    ) -> list[ToolRun]:
        candidates = [
            run
            for run in self.runs_by_id.values()
            if run.requested_by_user_id == user_id and run.context == context
        ]
        ordered = sorted(candidates, key=lambda run: run.requested_at, reverse=True)
        return ordered[:limit]

    async def count_for_user_this_month(
        self,
        *,
        user_id: UUID,
        context: RunContext,
    ) -> int:
        candidates = [
            run
            for run in self.runs_by_id.values()
            if run.requested_by_user_id == user_id and run.context == context
        ]
        return len(candidates)

    async def list_recent_tools_for_user(
        self,
        *,
        user_id: UUID,
        limit: int = 10,
    ) -> list[RecentRunRow]:
        del user_id, limit
        return []


class InMemoryArtifactManager(ArtifactManagerProtocol):
    def __init__(self) -> None:
        self._artifacts: dict[UUID, dict[str, bytes]] = {}

    def store_output_archive(
        self,
        *,
        run_id: UUID,
        output_archive: Iterable[bytes],
        reported_artifacts: list[RunnerArtifact],
    ) -> ArtifactsManifest:
        del reported_artifacts
        stored: dict[str, bytes] = {}
        manifest: list[StoredArtifact] = []

        for archive_bytes in output_archive:
            with tarfile.open(fileobj=io.BytesIO(archive_bytes), mode="r:") as tar:
                for member in tar.getmembers():
                    if not member.isfile():
                        continue
                    extracted = tar.extractfile(member)
                    if extracted is None:
                        continue
                    content = extracted.read()
                    stored[member.name] = content
                    manifest.append(
                        StoredArtifact(
                            artifact_id=f"{len(manifest)}",
                            path=member.name,
                            bytes=len(content),
                        )
                    )

        self._artifacts[run_id] = stored
        return ArtifactsManifest(artifacts=manifest)

    def read_artifact(self, *, run_id: UUID, artifact_path: str) -> bytes:
        return self._artifacts[run_id][artifact_path]


