          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <label
                for="rpc-students"
                class="text-sm font-semibold text-navy"
              >Antal elever</label>
              <input
                id="rpc-students"
                v-model.number="form.studentCount"
