class ListAllCategoriesHandlerProtocol(Protocol):
    async def handle(self, query: ListAllCategoriesQuery) -> ListAllCategoriesResult: ...


class ListToolsForAdminHandlerProtocol(Protocol):
    async def handle(
        self,
