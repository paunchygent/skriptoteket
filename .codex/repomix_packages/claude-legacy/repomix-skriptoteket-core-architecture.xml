    LLM_CHAT_OPS_GPT5_CONTEXT_WINDOW_TOKENS: int = 64 * 1024
    LLM_CHAT_OPS_CONTEXT_SAFETY_MARGIN_TOKENS: int = 256
    # Chat-ops prompts include strict JSON-only schema + rules.
