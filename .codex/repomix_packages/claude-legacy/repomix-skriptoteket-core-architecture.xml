        return normalized


UiTableCellValue = str | int | float | bool | None
UiTableRow = dict[str, UiTableCellValue]


class UiTableOutput(BaseModel):
    model_config = ConfigDict(frozen=True)

    kind: Literal[UiOutputKind.TABLE] = UiOutputKind.TABLE
