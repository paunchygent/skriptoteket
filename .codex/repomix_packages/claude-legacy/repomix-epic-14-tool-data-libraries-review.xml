      <span
        v-if="isClear"
        :class="[isCompact ? 'text-[10px] font-semibold text-burgundy' : 'text-xs font-semibold text-burgundy']"
      >
        Rensar vid nästa körning.
      </span>
    </div>

    <p
      v-if="helperText"
      :class="[isCompact ? 'px-3 pb-2 text-[10px] text-navy/60' : 'px-3 pb-2 text-xs text-navy/60']"
