        )
        return DockerToolRunner(
            runner_image=settings.RUNNER_IMAGE,
            sandbox_timeout_seconds=settings.RUNNER_TIMEOUT_SANDBOX_SECONDS,
            production_timeout_seconds=settings.RUNNER_TIMEOUT_PRODUCTION_SECONDS,
            limits=limits,
