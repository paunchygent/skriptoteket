              </div>
              {% if tool.is_published and tool.active_version_id %}
                <a href="/tools/{{ tool.slug }}/run" class="huleedu-btn huleedu-btn-navy huleedu-btn-sm">Kör</a>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="huleedu-muted">Inga verktyg ännu.</p>
    {% endif %}
