{% extends "base.html" %}
{% block content %}
  <div class="huleedu-card huleedu-max-w-md huleedu-mx-auto">
    <h2>Logga in</h2>
    {% if error %}
      <p class="huleedu-error">{{ error }}</p>
    {% endif %}
    <form method="post" action="/login" class="huleedu-stack">
      <label class="huleedu-label">
