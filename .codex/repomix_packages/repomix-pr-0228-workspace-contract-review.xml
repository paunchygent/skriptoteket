    expect(wrapper.text()).toContain("Aktuellt sittschema");
    expect(wrapper.text()).toContain("Tidigare sittscheman");

    const openButton = wrapper.findAll("button").find((button) => button.text().includes("Revision 3"));
    if (!openButton) {
