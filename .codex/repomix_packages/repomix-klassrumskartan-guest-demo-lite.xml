                    app_id=item.app_id or "",
                    title=item.title,
                    summary=item.summary,
                    is_favorite=item.is_favorite,
                )
            )
    return ListAllToolsResponse(
        items=items,
        professions=[
            ProfessionItem(
                id=p.id,
                slug=p.slug,
                label=p.label,
                sort_order=p.sort_order,
            )
            for p in result.professions
        ],
        categories=[
