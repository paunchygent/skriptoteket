POSTGRES_DB=skriptoteket
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=55432

# Local tooling + `pdm run dev` (host-to-container mapping).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55432/skriptoteket
# Vite proxies share pages to the backend so copied dev links use the app host.
PUBLIC_APP_BASE_URL=http://localhost:5173

# Dev bootstrap account (set your own values in `.env`).
BOOTSTRAP_SUPERUSER_EMAIL=superuser@local.dev
BOOTSTRAP_SUPERUSER_PASSWORD=superuser-password

# Runner (ST-04-02)
# Note: Running the app container with sibling containers requires mounting /var/run/docker.sock
# (dev: compose.dev.yaml, prod opt-in: compose.runner.yaml).
RUNNER_IMAGE=skriptoteket-runner:latest
RUNNER_MAX_CONCURRENCY=1
RUNNER_TIMEOUT_SANDBOX_SECONDS=60
RUNNER_TIMEOUT_PRODUCTION_SECONDS=120
RUNNER_CPU_LIMIT=1.0
RUNNER_MEMORY_LIMIT=1g
RUNNER_PIDS_LIMIT=256

# Tool execution artifacts (local dev)
# IMPORTANT: the default `/var/lib/skriptoteket/artifacts` does not exist locally.
# Create the directory before running tools:
#   mkdir -p /tmp/skriptoteket/artifacts
ARTIFACTS_ROOT=/tmp/skriptoteket/artifacts
ARTIFACTS_RETENTION_DAYS=7

# Vault (user file library)
# Create the directory before saving files:
#   mkdir -p /tmp/skriptoteket/vault
VAULT_ROOT=/tmp/skriptoteket/vault
VAULT_MAX_FILE_BYTES=20000000
VAULT_MAX_TOTAL_BYTES=200000000
VAULT_RETENTION_DAYS=30

# Sir Convert-a-Lot v2 (private lane default)
# Default Docker development targets the canonical private Sir Convert tunnel
# through the Docker host at http://host.docker.internal:28085. The tunnel is
# not started automatically; start it on the MacBook before conversion work.
# A host-run client outside Docker overrides this to http://127.0.0.1:28085.
# For async export flows, set a callback base URL only when Sir Convert can
# reach that URL. Sir Convert production stays offline by user decision.
# Never run `pdm run serve:sir-convert-a-lot` or a host `uvicorn ...service:app`
# process for the default dev path.
SIR_CONVERT_A_LOT_V2_BASE_URL=http://host.docker.internal:28085
SIR_CONVERT_A_LOT_V2_API_KEY=change-me
SIR_CONVERT_A_LOT_V2_CALLBACK_BASE_URL=

# Platform-only debug capture (OFF by default; see ADR-0051)
# When enabled, writes sensitive captures under `ARTIFACTS_ROOT/llm-captures/` (model output + tool code).
LLM_CAPTURE_ON_ERROR_ENABLED=false
# Dev-only: capture successful chat-ops responses
LLM_CAPTURE_ON_SUCCESS_ENABLED=false

# Email (SMTP)
# Note: keep each EMAIL_* key only once (duplicates are confusing; last one wins).
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=mail.privateemail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=change-me
EMAIL_SMTP_PASSWORD=change-me
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_TIMEOUT=30
EMAIL_DEFAULT_FROM_EMAIL=noreply@hule.education
EMAIL_DEFAULT_FROM_NAME=Skriptoteket

# Email verification
EMAIL_VERIFICATION_BASE_URL=http://localhost:8000

# Observability (HuleEdu-compatible structlog)
SERVICE_NAME=skriptoteket
LOG_LEVEL=INFO
LOG_FORMAT=console

# Health checks
# Include SMTP dependency in /healthz (only applies when EMAIL_PROVIDER=smtp).
HEALTHZ_SMTP_CHECK_ENABLED=true

# AI / LLM
#
# Every editor AI call (inline completion, chat, chat ops, edit) goes through the HuleEdu
# LLM provider door with the teacher's user id. Models are set in config.py; override here only
# to change a model or reasoning effort.
LLM_COMPLETION_ENABLED=true
LLM_COMPLETION_MODEL=gpt-6-luna
LLM_COMPLETION_REASONING_EFFORT=none
#LLM_COMPLETION_TEXT_VERBOSITY=low

LLM_CHAT_ENABLED=true
LLM_CHAT_MODEL=gpt-6.1-sol
LLM_CHAT_REASONING_EFFORT=low
#LLM_CHAT_TEXT_VERBOSITY=medium
LLM_CHAT_TEMPLATE_ID=editor_chat_v1

LLM_CHAT_OPS_ENABLED=true
LLM_CHAT_OPS_MODEL=gpt-6.1-sol
LLM_CHAT_OPS_REASONING_EFFORT=low
#LLM_CHAT_OPS_TEXT_VERBOSITY=low
LLM_CHAT_OPS_TEMPLATE_ID=editor_chat_ops_v1

# HuleEdu LLM provider door (editor AI and exam answer-key proposals).
LLM_ANSWER_KEY_ENABLED=true
#HULEEDU_LLM_PROVIDER_BASE_URL=http://huleedu_llm_provider_service:8080
HULEEDU_INTERNAL_API_KEY=change-me

# UI tests (optional)
PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=mac-arm64

# Home server observability creds (optional; used by compose.observability + reverse proxy)
#GRAFANA_ADMIN_PASSWORD=change-me
#PROMETHEUS_BASIC_AUTH_PASSWORD=change-me
#JAEGER_BASIC_AUTH_PASSWORD=change-me

# Frontend dev server (legacy SSR + SPA islands; ADR-0025 superseded by ADR-0027)
# If set, server-rendered templates load frontend assets from the Vite dev server.
# Production curated apps are backend-gated via an explicit allowlist so demo and
# in-development apps do not leak into prod by registry default.
# CURATED_APPS_PRODUCTION_ALLOWLIST=chemistry.reagent_prep_chef,documents.conversion_hub,classroom.group-seating-studio
# VITE_DEV_SERVER_URL=http://localhost:5173

# HuleEdu shared-auth dev edge (optional overrides for Docker dev)
# The normal Docker dev defaults use the local HuleEdu Gateway on port 8080.
# The web service mounts the HuleEdu local public key from the adjacent checkout
# unless this host path is overridden.
# HULEEDU_INTERNAL_IDENTITY_PUBLIC_KEY_HOST_PATH=../../huleedu/secrets/local-runtime/internal-identity/gateway-internal-identity-public-key.pem
# Production Hemma uses the HuleEdu runtime public key unless overridden.
# HULEEDU_INTERNAL_IDENTITY_PUBLIC_KEY_HOST_DIR=/home/paunchygent/apps/huledu/secrets/hemma-runtime/internal-identity
# VITE_DEV_BACKEND_PROXY_TARGET=http://skriptoteket_web:8000
# VITE_DEV_PUBLIC_API_PROXY_TARGET=http://skriptoteket_web:8000
# VITE_DEV_PROXY_TARGET=http://huleedu_api_gateway_service:8080
# VITE_HULEEDU_AUTH_BASE_URL=http://localhost:8080
# VITE_HULEEDU_AUTH_ENTRY_URL=http://localhost:8080/auth/login
