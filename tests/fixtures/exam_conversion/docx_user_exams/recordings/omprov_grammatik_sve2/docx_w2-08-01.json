        {
          "segments": [
            {
              "kind": "text",
              "text": "Stryk under bisatsen. Ange typ (att-sats, relativ bisats, tids-, orsaks-, villkors-, avsiktsbisats) och funktion (subjekt, objekt, adverbial, bestämning i NF).",
              "accepted_values": [],
              "asset_id": null
            }
          ]
        },
        {
          "segments": [
            {
              "kind": "text",
              "text": "1. Att hon vann överraskade ingen.",
              "accepted_values": [],
              "asset_id": null
            }
          ]
        },
        {
          "segments": [
            {
              "kind": "text",
              "text": "2. Jag undrar om han kommer.",
              "accepted_values": [],
              "asset_id": null
            }
          ]
        },
        {
          "segments": [
            {
              "kind": "text",
              "text": "3. Han gick hem eftersom han var sjuk.",
