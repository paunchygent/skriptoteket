              "asset_id": null
            }
          ]
        },
        {
          "segments": [
            {
              "kind": "text",
              "text": "6. De sparar pengar för att kunna resa.",
              "accepted_values": [],
              "asset_id": null
            }
          ]
        },
        {
          "segments": [
            {
              "kind": "text",
              "text": "7. När vi kom fram hade festen redan börjat.",
              "accepted_values": [],
              "asset_id": null
            }
          ]
        },
        {
          "segments": [
            {
              "kind": "text",
              "text": "8. Läraren berättade att provet var inställt.",
              "accepted_values": [],
              "asset_id": null
            }
          ]
        },
        {
          "segments": [
