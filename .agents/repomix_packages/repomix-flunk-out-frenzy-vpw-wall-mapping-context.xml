});

const FLIPPER_LENGTH = VPW_FLIPPER_GEOMETRY.length;
const FLIPPER_THICKNESS = VPW_FLIPPER_GEOMETRY.thickness;
export const PROTOTYPE_ALPHA_TABLE_SPEC = {
