  }),
  flipper: Object.freeze({
    id: "flipper",
    friction: 0.06,
    restitution: 0.18,
    angularDamping: 2.0,
  }),
  sensor: Object.freeze({
    id: "sensor",
    friction: 0,
    restitution: 0,
  }),
});
