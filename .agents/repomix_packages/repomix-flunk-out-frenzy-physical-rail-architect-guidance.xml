  VPW_RIGHT_UPPER_GUIDE_PATH,
} from "./donor/donorPlayfieldMap";
import { VPW_METAL_RAIL_3D_SPECS } from "./donor/donorLauncherMap";

export const VPW_FULL_BOARD_PATH_TARGET = Object.freeze({
  perimeterAndLanes: Object.freeze({
