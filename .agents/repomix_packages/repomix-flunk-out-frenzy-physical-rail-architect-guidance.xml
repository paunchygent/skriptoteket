 *
 * The detailed donor geometry now lives in focused donor submodules; this
 * barrel preserves the historical import surface for the rest of the game.
 */

export {
  PROTOTYPE_ALPHA_VPW_DONOR_BOARD,
  PROTOTYPE_ALPHA_VPW_DONOR_SCALE,
