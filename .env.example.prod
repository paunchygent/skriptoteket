# Production environment variables for home server deployment
# Copy to .env and fill in actual values

# Database (shared PostgreSQL on hule-network)
SKRIPTOTEKET_DB_PASSWORD=change-me

# Application secrets
SECRET_KEY=generate-with-python-secrets-token-urlsafe-32

# Observability (HuleEdu-compatible structlog)
SERVICE_NAME=skriptoteket
LOG_LEVEL=INFO
LOG_FORMAT=json

# Health checks
# Include SMTP dependency in /healthz (only applies when EMAIL_PROVIDER=smtp).
HEALTHZ_SMTP_CHECK_ENABLED=true

# Platform-only debug capture (OFF by default; see ADR-0051)
# When enabled, writes sensitive captures under `ARTIFACTS_ROOT/llm-captures/` (model output + tool code).
LLM_CAPTURE_ON_ERROR_ENABLED=false

# Bootstrap superuser (prod provisioning / UI smokes)
BOOTSTRAP_SUPERUSER_EMAIL=superuser@skriptoteket.hule.education
BOOTSTRAP_SUPERUSER_PASSWORD=change-me

# Email (SMTP)
# Note: keep each EMAIL_* key only once (duplicates are confusing; last one wins).
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=mail.privateemail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=change-me
EMAIL_SMTP_PASSWORD=change-me
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_TIMEOUT=30
EMAIL_DEFAULT_FROM_EMAIL=noreply@hule.education
EMAIL_DEFAULT_FROM_NAME=Skriptoteket
EMAIL_VERIFICATION_BASE_URL=https://skriptoteket.hule.education

# AI / LLM
#
# Every editor AI call (inline completion, chat, chat ops, edit) goes through the HuleEdu
# LLM provider door with the teacher's user id. Models are set in config.py; override here only
# to change a model or reasoning effort.
LLM_COMPLETION_ENABLED=true
LLM_COMPLETION_MODEL=gpt-6-luna
LLM_COMPLETION_REASONING_EFFORT=none
#LLM_COMPLETION_TEXT_VERBOSITY=low

LLM_CHAT_ENABLED=true
LLM_CHAT_MODEL=gpt-6.1-sol
LLM_CHAT_REASONING_EFFORT=low
#LLM_CHAT_TEXT_VERBOSITY=medium
LLM_CHAT_TEMPLATE_ID=editor_chat_v1

LLM_CHAT_OPS_ENABLED=true
LLM_CHAT_OPS_MODEL=gpt-6.1-sol
LLM_CHAT_OPS_REASONING_EFFORT=low
#LLM_CHAT_OPS_TEXT_VERBOSITY=low
LLM_CHAT_OPS_TEMPLATE_ID=editor_chat_ops_v1

# HuleEdu LLM provider door (editor AI and exam answer-key proposals).
LLM_ANSWER_KEY_ENABLED=true
#HULEEDU_LLM_PROVIDER_BASE_URL=http://huleedu_llm_provider_service:8080
HULEEDU_INTERNAL_API_KEY=change-me

# Sir Convert-a-Lot v2 (Conversion Hub upstream)
# On Hemma, use the private conversion service on `hule-network`:
# http://sir_convert_a_lot_prod:8085. The old public hostname is retired.
# Host-run operator clients use a separately managed private tunnel at
# http://127.0.0.1:28085 instead of container service DNS.
# Sir Convert production stays offline by user decision.
# Skriptoteket uses only the canonical v2 API key name.
SIR_CONVERT_A_LOT_V2_BASE_URL=http://sir_convert_a_lot_prod:8085
SIR_CONVERT_A_LOT_V2_API_KEY=change-me
SIR_CONVERT_A_LOT_V2_CALLBACK_BASE_URL=https://skriptoteket.hule.education
#SIR_CONVERT_A_LOT_V2_TIMEOUT_SECONDS=60

# Observability stack (compose.observability.yaml)
GRAFANA_ADMIN_PASSWORD=change-me
PROMETHEUS_BASIC_AUTH_PASSWORD=change-me
JAEGER_BASIC_AUTH_PASSWORD=change-me
